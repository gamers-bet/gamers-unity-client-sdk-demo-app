    "Runtime.meta",
    "Editor.meta",
    "README.md.meta",
    "CHANGELOG.md.meta",
    "LICENSE.pdf.meta",
    "Third Party Notices.md.meta",
    "link.xml.meta"
  ],
  "unity": "2022.3",
  "unityRelease": "0",
  "license": "SEE LICENSE IN LICENSE.pdf",
  "documentationUrl": "https://github.com/gamers-bet/gamers-unity-client-sdk-demo-app/blob/main/README.md",
  "changelogUrl": "https://developer.gamers.dev/docs/client-sdk-changelog",
  "keywords": ["gamers", "client", "events", "tournaments"],
